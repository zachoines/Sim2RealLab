# Environment for the sim-bridge autonomy lane.
#
# The policy stack on the Jetson consuming the Isaac Sim bridge over
# CycloneDDS: the hybrid backend driving the depth-subgoal policy, at sim
# rates. Layered over env_autonomy.env by the sim-bridge overlay, which loads
# both generated mirrors and takes the later file's value for a duplicate key.
#
# SIM ONLY. This lane is opt-in behind an explicit `-f` and must never be
# applied on the real robot: it widens two freshness windows the real-hardware
# guard exists to keep tight, and it selects a policy backend that fails closed
# rather than falling back to Nav2.

# navigate_to_pose backend — drives BOTH the executor dispatch AND which
# inference nodes the bringup auto-launches. The sim-bridge lane runs the
# policy, so the inference service rejects a nav2 backend at launch.
export STRAFER_NAV_BACKEND=hybrid_nav2_strafer
# PolicyVariant for the hybrid backend: DEPTH_SUBGOAL restores late-obstacle
# avoidance from perception, where NOCAM_SUBGOAL trusts the costmap alone.
export STRAFER_POLICY_VARIANT=DEPTH_SUBGOAL
# The bridge publishes /clock; every node on this lane must read it or the
# policy's deadlines run against wall time while the sim runs slower.
export STRAFER_USE_SIM_TIME=true

# Simulated sensors arrive well under the real-hardware rates the watchdog
# windows are sized for; both widen or it zero-twists a healthy mission.
# The inference node's obs watchdog (imu / joint_states / odom freshness):
# the bridge publishes those at ~12 Hz render-bound, so the real-robot 0.2 s
# default trips on ordinary jitter. 1.0 s still catches a dead stream.
export STRAFER_OBS_TIMEOUT_S=1.0
# Depth's own window for the depth variants. The bridge publishes depth at
# ~3 Hz wall at the rig's low RTF, so the ~0.33 s inter-frame gaps plus jitter
# sit against the real-robot 0.5 s default. 2.0 s still catches a dead camera.
export STRAFER_DEPTH_TIMEOUT_S=2.0

# Depth subscription reliability. The bridge's camera publisher is RELIABLE, so
# a reliable subscriber matches it and recovers the fragments a ~921 KB frame
# loses in transit — each one an inference the recurrent policy would otherwise
# skip, and a hidden-state step training always takes. The subscription keeps
# history depth 1, so recovery cannot turn into a backlog of stale frames.
# Real-robot bringup leaves this unset: its publisher QoS is not pinned, and a
# reliable subscriber receives nothing at all from a best-effort one.
export STRAFER_DEPTH_RELIABILITY=reliable
